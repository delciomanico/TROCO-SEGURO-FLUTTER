                      ),
                    ),
                  ],
                ),
                SizedBox(height: responsive.scaledHeight(20)),
                Container(
                  height: 1,
                  color: Colors.white.withOpacity(0.2),
                ),
                SizedBox(height: responsive.scaledHeight(16)),
                Row(
                  children: [
                    Expanded(
                      child: _buildStatItem(
                        responsive,
                        'Hoje',
                        _formatCurrency(todayEarnings),
                        Icons.trending_up,
                        AppColors.accent,
                      ),
                    ),
                    SizedBox(width: responsive.scaledWidth(12)),
                    Expanded(
                      child: _buildStatItem(
                        responsive,
                        'Viagens',
                        '$todayTrips',
                        Icons.local_taxi,
                        Colors.white70,
                      ),
                    ),
                  ],
                ),
              ],
            ),
          ),
        ],
      ),
    );
  }

  Widget _buildStatItem(
    ResponsiveHelper responsive,
    String label,
    String value,
    IconData icon,
    Color color,
  ) {
    return Container(
      padding: EdgeInsets.all(responsive.responsiveSpacing()),
      decoration: BoxDecoration(
        color: Colors.white.withOpacity(0.1),
        borderRadius: BorderRadius.circular(12),
      ),
      child: Row(
        children: [
          Icon(icon, size: 18, color: color),
          SizedBox(width: responsive.scaledWidth(8)),
          Column(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              Text(
                label,
                style: TextStyle(
                  fontSize: responsive.responsiveFontSize(10),
                  color: Colors.white60,
                ),
              ),
              Text(
                value,
                style: TextStyle(
                  fontSize: responsive.responsiveFontSize(13),
                  fontWeight: FontWeight.w700,
                  color: Colors.white,
                ),
              ),
            ],
          ),
        ],
      ),
    );
  }

