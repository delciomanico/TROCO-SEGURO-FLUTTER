                ),
                SizedBox(width: responsive.scaledWidth(16)),
                Expanded(
                  child: Column(
                    crossAxisAlignment: CrossAxisAlignment.start,
                    children: [
                      Text(
                        widget.isOnline
                            ? 'ESCANEAR CARTÃO VIRTUAL'
                            : 'FIQUE ONLINE',
                        style: TextStyle(
                          fontSize: responsive.responsiveFontSize(16),
                          fontWeight: FontWeight.w900,
                          color: widget.isOnline ? Colors.white : Colors.grey,
                          letterSpacing: 0.5,
                        ),
                      ),
                      SizedBox(height: 4),
                      Text(
                        widget.isOnline
                            ? 'Escaneie o QR do passageiro para cobrar'
                            : 'Ative o status online para receber',
                        style: TextStyle(
                          fontSize: responsive.responsiveFontSize(12),
                          color: widget.isOnline ? Colors.white70 : Colors.grey,
                        ),
                      ),
                    ],
                  ),
                ),
                Icon(
                  Icons.arrow_forward_ios,
                  size: responsive.scaledWidth(18),
                  color: widget.isOnline ? Colors.white70 : Colors.grey,
                ),
              ],
            ),
          ),
        ),
        SizedBox(height: responsive.scaledHeight(12)),

        // Card de configuração atual do QR
        if (_qrConfig != null &&
            (_qrConfig!.activeRouteName != null || _qrConfig!.currentFare > 0))
          Container(
            margin: EdgeInsets.only(bottom: responsive.scaledHeight(12)),
            padding: EdgeInsets.all(responsive.responsivePadding()),
            decoration: BoxDecoration(
              color: AppColors.accent.withOpacity(0.1),
              borderRadius:
                  BorderRadius.circular(responsive.responsiveBorderRadius()),
              border: Border.all(color: AppColors.accent.withOpacity(0.3)),
            ),
            child: Row(
              children: [
                Icon(
                  Icons.info_outline_rounded,
                  color: AppColors.accent,
                  size: responsive.scaledWidth(20),
                ),
                SizedBox(width: responsive.scaledWidth(12)),
                Expanded(
                  child: Column(
                    crossAxisAlignment: CrossAxisAlignment.start,
                    children: [
                      Text(
                        'QR Code configurado:',
                        style: TextStyle(
                          fontSize: responsive.responsiveFontSize(11),
                          color: AppColors.textSecondary,
                        ),
                      ),
                      Text(
                        _qrConfig!.activeRouteName != null
                            ? '${_qrConfig!.activeRouteName} • ${_formatCurrency(_qrConfig!.currentFare)}'
                            : _formatCurrency(_qrConfig!.currentFare),
                        style: TextStyle(
                          fontSize: responsive.responsiveFontSize(13),
                          fontWeight: FontWeight.w700,
                          color: AppColors.text,
                        ),
                        overflow: TextOverflow.ellipsis,
                        maxLines: 1,
                      ),
                    ],
                  ),
                ),
                SizedBox(width: responsive.scaledWidth(8)),
                GestureDetector(
                  onTap: _showQRConfig,
                  child: Container(
                    padding: EdgeInsets.all(responsive.scaledWidth(8)),
                    decoration: BoxDecoration(
                      color: AppColors.accent.withOpacity(0.2),
                      borderRadius: BorderRadius.circular(8),
                    ),
                    child: Icon(
                      Icons.edit_rounded,
                      color: AppColors.accent,
                      size: responsive.scaledWidth(18),
                    ),
                  ),
                ),
              ],
            ),
          ),

        // Botões de QR
        Row(
          children: [
            // Botão MOSTRAR MEU QR
            Expanded(
              flex: 2,
              child: GestureDetector(
                onTap: widget.isOnline ? _showQRCode : null,
                child: Container(
                  padding: EdgeInsets.symmetric(
                    horizontal: responsive.responsivePadding(),
                    vertical: responsive.responsivePadding() * 0.8,
                  ),
                  decoration: BoxDecoration(
                    color: widget.isOnline
                        ? AppColors.darkBlue.withOpacity(0.1)
                        : Colors.grey.shade200,
                    borderRadius: BorderRadius.circular(
                        responsive.responsiveBorderRadius()),
                    border: Border.all(
                      color: widget.isOnline
                          ? AppColors.darkBlue
                          : Colors.grey.shade300,
                      width: 1.5,
                    ),
                  ),
                  child: Row(
                    mainAxisAlignment: MainAxisAlignment.center,
                    children: [
                      Icon(
                        Icons.qr_code_2_rounded,
                        size: responsive.scaledWidth(24),
                        color:
                            widget.isOnline ? AppColors.darkBlue : Colors.grey,
                      ),
                      SizedBox(width: responsive.scaledWidth(8)),
                      Text(
                        'MEU QR CODE',
                        style: TextStyle(
                          fontSize: responsive.responsiveFontSize(12),
                          fontWeight: FontWeight.w700,
                          color: widget.isOnline
                              ? AppColors.darkBlue
                              : Colors.grey,
                          letterSpacing: 0.5,
                        ),
                      ),
                    ],
                  ),
                ),
              ),
            ),
            SizedBox(width: responsive.scaledWidth(12)),
            // Botão CONFIGURAR QR
            Expanded(
              child: GestureDetector(
                onTap: widget.isOnline ? _showQRConfig : null,
                child: Container(
                  padding: EdgeInsets.symmetric(
                    horizontal: responsive.responsivePadding() * 0.5,
                    vertical: responsive.responsivePadding() * 0.8,
                  ),
                  decoration: BoxDecoration(
                    gradient: widget.isOnline
                        ? LinearGradient(
                            colors: [
                              AppColors.accent,
                              AppColors.accent.withOpacity(0.8)
                            ],
                          )
                        : null,
                    color: widget.isOnline ? null : Colors.grey.shade200,
                    borderRadius: BorderRadius.circular(
                        responsive.responsiveBorderRadius()),
                  ),
                  child: Row(
                    mainAxisAlignment: MainAxisAlignment.center,
                    children: [
                      Icon(
                        Icons.settings_rounded,
                        size: responsive.scaledWidth(20),
                        color: widget.isOnline ? Colors.white : Colors.grey,
                      ),
                      SizedBox(width: responsive.scaledWidth(6)),
                      Text(
                        'CONFIG',
                        style: TextStyle(
                          fontSize: responsive.responsiveFontSize(11),
                          fontWeight: FontWeight.w700,
                          color: widget.isOnline ? Colors.white : Colors.grey,
                        ),
                      ),
                    ],
                  ),
                ),
              ),
            ),
          ],
        ),
      ],
    );
  }

  Widget _buildQRCodeButton(ResponsiveHelper responsive) {
    return GestureDetector(
      onTap: widget.isOnline ? _showQRCode : null,
      child: Container(
        padding: EdgeInsets.all(responsive.responsivePadding() * 1.5),
        decoration: BoxDecoration(
          gradient: widget.isOnline
              ? const LinearGradient(
                  colors: [Color(0xFFF6B415), Color(0xFFF9C846)],
                  begin: Alignment.topLeft,
                  end: Alignment.bottomRight,
                )
              : null,
          color: widget.isOnline ? null : Colors.grey.shade300,
          borderRadius:
              BorderRadius.circular(responsive.responsiveBorderRadius()),
          boxShadow: widget.isOnline
              ? [
                  BoxShadow(
                    color: AppColors.accent.withOpacity(0.3),
                    blurRadius: 15,
                    offset: const Offset(0, 8),
                  ),
                ]
              : null,
        ),
        child: Row(
          mainAxisAlignment: MainAxisAlignment.center,
          children: [
            Icon(
              Icons.qr_code_2_rounded,
              size: responsive.scaledWidth(48),
              color: widget.isOnline ? Colors.white : Colors.grey,
            ),
            SizedBox(width: responsive.scaledWidth(16)),
            Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                Text(
                  widget.isOnline ? 'MOSTRAR QR CODE' : 'FIQUE ONLINE',
                  style: TextStyle(
                    fontSize: responsive.responsiveFontSize(18),
                    fontWeight: FontWeight.w900,
                    color: widget.isOnline ? Colors.white : Colors.grey,
                    letterSpacing: 1,
                  ),
                ),
                const SizedBox(height: 4),
                Text(
                  widget.isOnline
                      ? 'Toque para receber pagamento'
                      : 'Ative o status online para receber',
                  style: TextStyle(
                    fontSize: responsive.responsiveFontSize(12),
                    color: widget.isOnline ? Colors.white70 : Colors.grey,
                  ),
                ),
              ],
            ),
          ],
        ),
      ),
    );
  }

  Widget _buildTodayStats(ResponsiveHelper responsive) {
    return Container(
      padding: EdgeInsets.all(responsive.responsivePadding()),
      decoration: BoxDecoration(
        color: Theme.of(context).cardColor,
        borderRadius:
            BorderRadius.circular(responsive.responsiveBorderRadius()),
        border: Border.all(color: AppColors.cardBorder),
      ),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Row(
            children: [
              Icon(
                Icons.insights_rounded,
                color: AppColors.darkBlue,
                size: responsive.scaledWidth(20),
              ),
              SizedBox(width: responsive.scaledWidth(8)),
              Text(
                'Resumo de Hoje',
                style: TextStyle(
                  fontSize: responsive.responsiveFontSize(16),
                  fontWeight: FontWeight.w800,
                  color: AppColors.text,
                ),
              ),
            ],
          ),
          SizedBox(height: responsive.scaledHeight(16)),
          Row(
            children: [
              Expanded(
                child: _buildStatCard(
                  responsive,
                  'Ganhos',
                  _formatCurrency(todayEarnings),
                  Icons.attach_money_rounded,
                  AppColors.accent,
                ),
              ),
              SizedBox(width: responsive.scaledWidth(12)),
              Expanded(
                child: _buildStatCard(
                  responsive,
                  'Viagens',
                  '$todayTrips',
                  Icons.local_taxi_rounded,
                  AppColors.darkBlue,
                ),
              ),
              SizedBox(width: responsive.scaledWidth(12)),
              Expanded(
                child: _buildStatCard(
                  responsive,
                  'Avaliação',
                  widget.driver.rating?.toStringAsFixed(1) ?? '5.0',
                  Icons.star_rounded,
                  Colors.amber,
                ),
              ),
            ],
          ),
        ],
      ),
    );
  }

  Widget _buildStatCard(
    ResponsiveHelper responsive,
    String label,
    String value,
    IconData icon,
    Color color,
  ) {
    return Container(
      padding: EdgeInsets.all(responsive.responsiveSpacing()),
      decoration: BoxDecoration(
        color: color.withOpacity(0.1),
        borderRadius: BorderRadius.circular(12),
      ),
      child: Column(
        children: [
          Icon(icon, color: color, size: 24),
          SizedBox(height: responsive.scaledHeight(8)),
          Text(
            value,
            style: TextStyle(
              fontSize: responsive.responsiveFontSize(14),
              fontWeight: FontWeight.w800,
              color: AppColors.text,
            ),
          ),
          Text(
            label,
            style: TextStyle(
              fontSize: responsive.responsiveFontSize(10),
              color: AppColors.textSecondary,
            ),
          ),
        ],
      ),
    );
  }

  Widget _buildRoutesCard(ResponsiveHelper responsive) {
    return GestureDetector(
      onTap: () {
        Navigator.push(
          context,
          MaterialPageRoute(builder: (context) => const RoutesScreen()),
        );
      },
      child: Container(
        padding: EdgeInsets.all(responsive.responsivePadding()),
        decoration: BoxDecoration(
          gradient: LinearGradient(
            colors: [
              AppColors.darkBlue,
              AppColors.darkBlueSurface,
            ],
            begin: Alignment.topLeft,
            end: Alignment.bottomRight,
          ),
          borderRadius:
              BorderRadius.circular(responsive.responsiveBorderRadius()),
          boxShadow: [
            BoxShadow(
              color: AppColors.darkBlue.withOpacity(0.2),
              blurRadius: 10,
              offset: const Offset(0, 4),
            ),
          ],
        ),
        child: Row(
          children: [
            Container(
              padding: EdgeInsets.all(responsive.scaledWidth(12)),
              decoration: BoxDecoration(
                color: AppColors.accent.withOpacity(0.2),
                borderRadius: BorderRadius.circular(12),
              ),
              child: Icon(
                Icons.route_rounded,
                color: AppColors.accent,
                size: responsive.scaledWidth(28),
              ),
            ),
            SizedBox(width: responsive.scaledWidth(16)),
            Expanded(
              child: Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  Text(
                    'Ver Rotas',
                    style: TextStyle(
                      fontSize: responsive.responsiveFontSize(16),
                      fontWeight: FontWeight.w700,
                      color: Colors.white,
                    ),
                  ),
                  SizedBox(height: responsive.scaledHeight(4)),
                  Text(
                    'Trânsito, táxis ativos e mais',
                    style: TextStyle(
                      fontSize: responsive.responsiveFontSize(12),
                      color: Colors.white70,
                    ),
                  ),
                ],
              ),
            ),
            Container(
              padding: EdgeInsets.all(responsive.scaledWidth(8)),
              decoration: BoxDecoration(
                color: Colors.white.withOpacity(0.1),
                borderRadius: BorderRadius.circular(8),
              ),
              child: Icon(
                Icons.arrow_forward_ios_rounded,
                color: Colors.white70,
                size: responsive.scaledWidth(16),
              ),
            ),
          ],
        ),
      ),
    );
  }

  Widget _buildTipsSection(ResponsiveHelper responsive) {
    return Container(
      padding: EdgeInsets.all(responsive.responsivePadding()),
      decoration: BoxDecoration(
        color: AppColors.accent.withOpacity(0.1),
        borderRadius:
            BorderRadius.circular(responsive.responsiveBorderRadius()),
        border: Border.all(color: AppColors.accent.withOpacity(0.3)),
      ),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Row(
            children: [
              Icon(
                Icons.tips_and_updates_rounded,
                color: AppColors.accent,
                size: responsive.scaledWidth(20),
              ),
              SizedBox(width: responsive.scaledWidth(8)),
              Text(
                'Dica',
                style: TextStyle(
                  fontSize: responsive.responsiveFontSize(14),
                  fontWeight: FontWeight.w800,
                  color: AppColors.accent,
                ),
              ),
            ],
          ),
          SizedBox(height: responsive.scaledHeight(8)),
          Text(
            'Mantenha seu status "Online" enquanto estiver disponível para corridas. '
            'Isso permite que passageiros encontrem seu QR Code e façam pagamentos.',
            style: TextStyle(
              fontSize: responsive.responsiveFontSize(12),
              color: AppColors.text,
              height: 1.5,
            ),
          ),
        ],
      ),
    );
  }
}
