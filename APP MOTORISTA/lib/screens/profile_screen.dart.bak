        elevation: 0,
        scrolledUnderElevation: 0,
        flexibleSpace: Container(
          decoration: const BoxDecoration(
            color: AppColors.darkBlue,
          ),
        ),
        foregroundColor: Colors.white,
        toolbarHeight: responsive.scaledHeight(70),
        title: Row(
          children: [
            Container(
              padding: EdgeInsets.all(responsive.scaledWidth(8)),
              decoration: BoxDecoration(
                color: AppColors.accent.withOpacity(0.2),
                borderRadius: BorderRadius.circular(10),
                border: Border.all(
                  color: AppColors.accent.withOpacity(0.6),
                  width: 1.5,
                ),
              ),
              child: Icon(
                Icons.person_rounded,
                size: responsive.scaledWidth(20),
                color: AppColors.accent,
              ),
            ),
            SizedBox(width: responsive.scaledWidth(12)),
            Text(
              'Perfil',
              style: TextStyle(
                fontSize: responsive.responsiveFontSize(20),
                fontWeight: FontWeight.w900,
                color: Colors.white,
              ),
            ),
          ],
        ),
      ),
      body: SingleChildScrollView(
        padding: responsive.responsiveAllPadding(),
        child: Column(
          children: [
            _buildProfileHeader(responsive),
            SizedBox(height: responsive.scaledHeight(24)),
            _buildVehicleInfo(responsive),
            SizedBox(height: responsive.scaledHeight(24)),
            _buildPersonalInfo(responsive),
            SizedBox(height: responsive.scaledHeight(24)),
            _buildSecuritySettings(responsive),
            SizedBox(height: responsive.scaledHeight(24)),
            _buildAppSettings(responsive),
            SizedBox(height: responsive.scaledHeight(24)),
            _buildSupportSection(responsive),
            SizedBox(height: responsive.scaledHeight(32)),
            _buildLogoutButton(responsive),
            SizedBox(height: responsive.scaledHeight(40)),
          ],
        ),
      ),
    );
  }

  Widget _buildProfileHeader(ResponsiveHelper responsive) {
    return Column(
      children: [
        Container(
          width: responsive.scaledWidth(80),
          height: responsive.scaledWidth(80),
          decoration: BoxDecoration(
            color: AppColors.darkBlue,
            shape: BoxShape.circle,
            border: Border.all(
              color: AppColors.accent,
              width: 3,
            ),
          ),
          child: Icon(
            Icons.person_rounded,
            size: responsive.scaledWidth(40),
            color: Colors.white,
          ),
        ),
        SizedBox(height: responsive.scaledHeight(16)),
        Text(
          driver?.fullName ?? 'Motorista',
          style: TextStyle(
            fontSize: responsive.responsiveFontSize(20),
            fontWeight: FontWeight.w900,
            color: AppColors.text,
