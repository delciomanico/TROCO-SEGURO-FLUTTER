import 'package:flutter/material.dart';
import 'package:troco_seguro_pro/models/driver_user.dart';
import 'package:troco_seguro_pro/utils/constants.dart';
import 'package:troco_seguro_pro/utils/responsive_helper.dart';
import 'package:troco_seguro_pro/widgets/custom_widgets.dart';
import 'package:troco_seguro_pro/services/api_service.dart';
import 'package:troco_seguro_pro/services/theme_controller.dart';
import 'package:troco_seguro_pro/services/secure_storage_service.dart';
import 'package:troco_seguro_pro/security/pin_guard.dart';
import 'package:shared_preferences/shared_preferences.dart';
import 'package:local_auth/local_auth.dart';
import 'dart:convert';

class ProfileScreen extends StatefulWidget {
  final VoidCallback? onLogout;

  const ProfileScreen({Key? key, this.onLogout}) : super(key: key);

  @override
  State<ProfileScreen> createState() => _ProfileScreenState();
}

class _ProfileScreenState extends State<ProfileScreen> {
  DriverUser? driver;
  bool notificationsEnabled = true;
  bool biometricsEnabled = false;
  bool darkModeEnabled = false;
  bool isLoading = false;
  final ApiService _api = ApiService();

  // ========== MODO MOCK (DESENVOLVIMENTO) ==========
  static const bool useMockData = true;
  // =================================================

  @override
  void initState() {
    super.initState();
    _loadData();
  }

  Future<void> _loadData() async {
    // ========== MODO MOCK ==========
    if (useMockData) {
      final prefs = await SharedPreferences.getInstance();
      final bioPref = prefs.getBool('ts_bio_enabled') ?? false;
      final themePref = prefs.getString('ts_driver_theme_mode');

      setState(() {
        driver = Constants.mockDriver;
        biometricsEnabled = bioPref;
        darkModeEnabled = themePref == 'dark';
      });
      return;
    }
    // ================================

    await _api.loadTokens();

    final prefs = await SharedPreferences.getInstance();
    final driverJson = prefs.getString('ts_driver');
    final bioPref = prefs.getBool('ts_bio_enabled') ?? false;
    final themePref = prefs.getString('ts_driver_theme_mode');

    setState(() {
      biometricsEnabled = bioPref;
      darkModeEnabled = themePref == 'dark';
      if (driverJson != null) {
        driver = DriverUser.fromJson(json.decode(driverJson));
      }
    });

    // Atualizar com dados da API
    final profileResult = await _api.getProfile();
    if (profileResult.isSuccess && profileResult.data != null) {
      setState(() => driver = profileResult.data!);
      await prefs.setString('ts_driver', json.encode(driver!.toJson()));
    }
  }

  void _showEditDialog(String field) {
    if (driver == null) return;

    String initialValue = '';
    String title = '';
    TextInputType keyboardType = TextInputType.text;

    switch (field) {
      case 'name':
        initialValue = driver!.fullName;
        title = 'Editar nome';
        break;
      case 'email':
        initialValue = driver!.email ?? '';
        title = 'Editar email';
        keyboardType = TextInputType.emailAddress;
        break;
      case 'licensePlate':
        initialValue = driver!.licensePlate ?? '';
        title = 'Editar matrícula';
        break;
      case 'vehicleModel':
        initialValue = driver!.vehicleModel ?? '';
        title = 'Editar modelo do veículo';
        break;
      case 'bankAccount':
        initialValue = driver!.bankAccount ?? '';
        title = 'Editar conta bancária';
        keyboardType = TextInputType.number;
        break;
    }

    final controller = TextEditingController(text: initialValue);

    showDialog(
      context: context,
      builder: (context) => AlertDialog(
        title: Text(title),
        content: TextField(
          controller: controller,
          keyboardType: keyboardType,
          decoration: InputDecoration(
            border: OutlineInputBorder(
              borderRadius: BorderRadius.circular(12),
            ),
          ),
        ),
        actions: [
          TextButton(
            onPressed: () => Navigator.pop(context),
            child: const Text('Cancelar'),
          ),
          TextButton(
            onPressed: () async {
              Navigator.pop(context);
              await _updateField(field, controller.text);
            },
            child: const Text('Salvar'),
          ),
        ],
      ),
    );
  }

  Future<void> _updateField(String field, String value) async {
    final result = await _api.updateProfile(
      fullName: field == 'name' ? value : null,
      email: field == 'email' ? value : null,
      licensePlate: field == 'licensePlate' ? value : null,
      vehicleModel: field == 'vehicleModel' ? value : null,
      bankAccount: field == 'bankAccount' ? value : null,
    );

    if (result.isSuccess && result.data != null) {
      setState(() => driver = result.data!);
      final prefs = await SharedPreferences.getInstance();
      await prefs.setString('ts_driver', json.encode(driver!.toJson()));
      _showSnack('Perfil atualizado com sucesso');
    } else {
      _showSnack('Erro ao atualizar: ${result.error}');
    }
  }

  void _showSnack(String message) {
    ScaffoldMessenger.of(context).showSnackBar(
      SnackBar(content: Text(message)),
    );
  }

  Future<void> _toggleBiometrics(bool enabled) async {
    if (enabled) {
      final auth = LocalAuthentication();
      final canAuth = await auth.canCheckBiometrics;
      if (!canAuth) {
        _showSnack('Biometria não disponível neste dispositivo');
        return;
      }
      final didAuth = await auth.authenticate(
        localizedReason: 'Ative a biometria para desbloquear o app',
        options: const AuthenticationOptions(biometricOnly: true),
      );
      if (!didAuth) return;
    }

    final prefs = await SharedPreferences.getInstance();
    await prefs.setBool('ts_bio_enabled', enabled);
    setState(() => biometricsEnabled = enabled);
  }

  Future<void> _toggleDarkMode(bool enabled) async {
    await ThemeController.instance.setDark(enabled);
    setState(() => darkModeEnabled = enabled);
  }

  void _showChangePinDialog() {
    final currentPinController = TextEditingController();
    final newPinController = TextEditingController();

    showDialog(
      context: context,
      builder: (context) => AlertDialog(
        title: const Text('Alterar PIN'),
        content: Column(
          mainAxisSize: MainAxisSize.min,
          children: [
            TextField(
              controller: currentPinController,
              keyboardType: TextInputType.number,
              obscureText: true,
              maxLength: 6,
              decoration: const InputDecoration(
                labelText: 'PIN atual',
              ),
            ),
            TextField(
              controller: newPinController,
              keyboardType: TextInputType.number,
              obscureText: true,
              maxLength: 6,
              decoration: const InputDecoration(
                labelText: 'Novo PIN',
              ),
            ),
          ],
        ),
        actions: [
          TextButton(
            onPressed: () => Navigator.pop(context),
            child: const Text('Cancelar'),
          ),
          TextButton(
            onPressed: () async {
              final isValid = await PinGuard.validatePin(
                scope: 'global',
                enteredPin: currentPinController.text,
                readExpectedPin: () => SecureStorageService().readPin(),
              );

              if (isValid) {
                await SecureStorageService().savePin(newPinController.text);
                Navigator.pop(context);
                _showSnack('PIN alterado com sucesso');
              } else {
                _showSnack('PIN atual incorreto');
              }
            },
            child: const Text('Alterar'),
          ),
        ],
      ),
    );
  }

  void _showLogoutConfirmation() {
    showDialog(
      context: context,
      builder: (context) => AlertDialog(
        title: const Text('Sair da conta'),
        content: const Text('Tem certeza que deseja sair?'),
        actions: [
          TextButton(
            onPressed: () => Navigator.pop(context),
            child: const Text('Cancelar'),
          ),
          TextButton(
            onPressed: () {
              Navigator.pop(context);
              widget.onLogout?.call();
            },
            style: TextButton.styleFrom(foregroundColor: Colors.red),
            child: const Text('Sair'),
          ),
        ],
      ),
    );
  }

  @override
